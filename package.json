{
  "name": "plum-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "The Plumlang website and documentation at plum.elixpo.com.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:check": "node scripts/sync-docs.mjs --check",
    "orchard:sync": "node scripts/sync-orchard.mjs",
    "prebuild": "node scripts/sync-orchard.mjs",
    "predev": "node scripts/sync-orchard.mjs",
    "site:check": "python3 scripts/check_site.py out",
    "samples:check": "python3 scripts/check_samples.py",
    "pages:dev": "wrangler pages dev out",
    "deploy": "wrangler pages deploy out --project-name plum-elixpo --branch main --env-file .env.local",
    "deploy:preview": "wrangler pages deploy out --project-name plum-elixpo --branch preview --env-file .env.local"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "marked": "^18.1.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.166.0"
  }
}
