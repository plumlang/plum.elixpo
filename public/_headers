# Cloudflare Pages response headers for plum.elixpo.com.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Hashed build assets never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and the social images change rarely.
/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/banner.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-docs.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/plum-mark.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/plum-pixel.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/manifest.webmanifest
  Content-Type: application/manifest+json

# The installers, shown as text in a browser and piped to a shell by
# curl | sh and irm | iex. Short cache: a release can change them.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# The documentation for language models (llmstxt.org).
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# The playground: plumlang's WebAssembly build (make wasm) and its worker.
# Served as application/wasm, the browser compiles plum.wasm while it
# downloads. The names carry no hash and the three files must match, so
# they are revalidated on every load (a 304 when unchanged). No threads,
# so no Cross-Origin-Embedder-Policy is needed.
/playground/plum.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=0, must-revalidate
/playground/plum.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
/playground/worker.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
